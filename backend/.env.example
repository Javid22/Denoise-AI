# Comma-separated list of allowed frontend origins for CORS.
# Use "*" during local development.
# In production, set this to your deployed Netlify URL, e.g.:
#   FRONTEND_URL=https://denoiseai.netlify.app
FRONTEND_URL=*

# Most hosting providers (Render, Railway, Cloud Run) inject PORT
# automatically — you generally do not need to set this yourself.
# PORT=8000
