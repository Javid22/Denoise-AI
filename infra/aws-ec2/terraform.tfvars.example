# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit real values (especially
# allowed_ssh_cidr if you consider your IP sensitive).

aws_region       = "ap-south-1"
allowed_ssh_cidr = "203.0.113.4/32" # <-- replace with YOUR public IP + /32 (see README for how to find it)
git_repo_url     = "https://github.com/Javid22/Denoise-AI.git"
git_branch       = "main"
frontend_url     = "https://denoise-ai.netlify.app" # or "*" if not deployed yet
